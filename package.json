{
  "name": "evidencegraph",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "tsc -p packages/domain && tsc -p packages/engine && tsc -p packages/fixtures && tsc -p apps/web",
    "lint": "pnpm --filter web lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:pii": "node scripts/grep-pii.ts",
    "check:wording": "node scripts/check-wording.ts",
    "demo": "node scripts/demo.mjs",
    "e2e": "pnpm --filter web exec playwright test",
    "e2e:ui": "pnpm --filter web exec playwright test --ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:contrast && pnpm check:pii && pnpm check:wording && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
